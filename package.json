{
  "name": "zxchen-demo",
  "version": "1.0.0",
  "description": "一个从零开始构建的前端工程实践项目。",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:staging": "pnpm --filter web build:staging",
    "build:utils": "pnpm --filter @zxchen-demo/utils build",
    "build:ui": "pnpm --filter @zxchen-demo/ui build",
    "preview": "pnpm --filter web preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "ui:typecheck": "pnpm --filter @zxchen-demo/ui typecheck",
    "prepare": "husky",
    "publish:utils": "pnpm --filter @zxchen-demo/utils publish --no-git-checks",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "story": "pnpm --filter @zxchen-demo/ui storybook",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:component": "pnpm -r --if-present run test:component",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:unit:coverage": "pnpm -r --if-present run test:unit:coverage",
    "dev:e2e": "pnpm --filter @zxchen-demo/ui build && pnpm --filter web dev --host 127.0.0.1 --port 4173 --strictPort --mode e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:component  && pnpm test:integration && pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.44.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1"
  }
}
